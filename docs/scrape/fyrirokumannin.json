    {
      "type": "heading",
      "level": 3,
      "text": "Ekki vaða inn á skítugum skónum"
    },
    {
      "type": "text",
      "text": "Í samstarfi við PeBe höfum við þróað sérútbúna skóbakka úr þykku gúmmíi með kanti."
    },
    {
      "type": "heading",
      "level": 3,
      "text": "8.060kr m/vsk."
    },
    {
      "type": "link",
      "text": "Hafa samband",
      "href": "./hafa-samband"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Ljósabúnaður"
    },
    {
      "type": "text",
      "text": "Sérsniðnir ljósabogar frá Svíþjóð fyrir hús og ballest á vinnuvélar og dráttarvélar."
    },
    {
      "type": "text",
      "text": "Hafðu samband til að vita meira um úrvalið fyrir þína vél."
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Sendu okkur fyrirspurn"
    },
    {
      "type": "link",
      "text": "Hafa samband",
      "href": "./hafa-samband"
    }
